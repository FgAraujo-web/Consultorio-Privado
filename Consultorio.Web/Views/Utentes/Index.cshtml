@model IEnumerable<Utente>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="mb-0">Utentes</h1>

    <a asp-controller="Utentes"
       asp-action="Create"
       class="btn btn-primary">
        + Novo utente
    </a>
</div>

<p class="text-muted">
    Dados inteiramente fictícios · 25 registos por página
</p>

<form method="get" class="d-flex gap-2 mb-3"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Pesquisar (quando aplicável)"/><button class="btn btn-primary">Pesquisar</button></form>
<div class="table-responsive"><table class="table table-striped table-hover"><thead><tr><th>Codigo</th><th>Nome</th><th>DataNascimento</th><th>Telefone</th><th>Localidade</th><th></th></tr></thead><tbody>@foreach(var item in Model) {
    <tr><td>@item.Codigo</td><td>@item.Nome</td><td>@item.DataNascimento.ToString("dd/MM/yyyy")</td><td>@item.Localidade</td><td><a asp-action="Details" asp-route-id="@item.UtenteId">Ver</a></td></tr>
}
</tbody></table></div>
<nav class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-route-page="@Math.Max(1,(int)ViewBag.Page-1)" asp-route-q="@ViewBag.Query">Anterior</a><span class="align-self-center">Página @ViewBag.Page</span><a class="btn btn-outline-secondary" asp-route-page="@((int)ViewBag.Page+1)" asp-route-q="@ViewBag.Query">Seguinte</a></nav>

@model Consultorio.Web.Models.CriarUtenteViewModel
@{
    ViewData["Title"] = "Novo utente";
}

<h2>Novo utente</h2>
<p class="text-muted mb-4">Registo de um novo utente do consultório.</p>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-controller="Utentes" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Codigo" class="form-label"></label>
                    <input asp-for="Codigo" class="form-control" maxlength="50" />
                    <span asp-validation-for="Codigo" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" maxlength="150" />
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DataNascimento" class="form-label"></label>
                    <input asp-for="DataNascimento" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                    <span asp-validation-for="DataNascimento" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Telefone" class="form-label"></label>
                    <input asp-for="Telefone" class="form-control" />
                    <span asp-validation-for="Telefone" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Localidade" class="form-label"></label>
                    <input asp-for="Localidade" class="form-control" />
                    <span asp-validation-for="Localidade" class="text-danger small"></span>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input asp-for="Ativo" class="form-check-input" />
                        <label asp-for="Ativo" class="form-check-label">Utente ativo</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Guardar utente</button>
                <a asp-controller="Utentes" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

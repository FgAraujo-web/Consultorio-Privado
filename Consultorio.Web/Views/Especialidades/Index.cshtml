@model IEnumerable<Especialidade>
<h1>Especialidades</h1><p class="text-muted">Dados inteiramente fictícios · 25 registos por página</p>
<form method="get" class="d-flex gap-2 mb-3"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Pesquisar (quando aplicável)"/><button class="btn btn-primary">Pesquisar</button></form>
<div class="table-responsive"><table class="table table-striped table-hover"><thead><tr><th>Designacao</th><th></th></tr></thead><tbody>@foreach(var item in Model) {<tr><td>@item.Designacao</td><td><a asp-action="Details" asp-route-id="@item.EspecialidadeId">Ver</a></td></tr>}</tbody></table></div>
<nav class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-route-page="@Math.Max(1,(int)ViewBag.Page-1)" asp-route-q="@ViewBag.Query">Anterior</a><span class="align-self-center">Página @ViewBag.Page</span><a class="btn btn-outline-secondary" asp-route-page="@((int)ViewBag.Page+1)" asp-route-q="@ViewBag.Query">Seguinte</a></nav>

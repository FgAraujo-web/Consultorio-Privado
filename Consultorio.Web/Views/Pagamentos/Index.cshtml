@model IEnumerable<Consultorio.Domain.Entities.Pagamento>
@using System.Globalization
@{ ViewData["Title"] = "Pagamentos"; var pt = CultureInfo.GetCultureInfo("pt-PT"); }
<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="mb-0">Pagamentos</h2>
    <a asp-action="Create" class="btn btn-primary">+ Registar pagamento</a>
</div>
<p class="text-muted">Dados inteiramente fictícios · 25 registos por página</p>
<form method="get" class="d-flex gap-2 mb-3">
    <input name="q" value="@ViewBag.Query" class="form-control" placeholder="Pesquisar por utente, referência ou método" />
    <button class="btn btn-primary">Pesquisar</button>
</form>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead><tr><th>Consulta</th><th>Utente</th><th>Referência</th><th>Data</th><th>Método</th><th class="text-end">Valor</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>#@item.ConsultaId</td>
                <td>@(item.Consulta?.Utente?.Nome ?? "—")</td>
                <td>@item.ReferenciaFicticia</td>
                <td>@item.DataPagamento.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.Metodo</td>
                <td class="text-end">@item.Valor.ToString("C", pt)</td>
                <td><a asp-action="Details" asp-route-id="@item.PagamentoId">Ver</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (!Model.Any()) { <p class="text-muted">Não foram encontrados pagamentos.</p> }
<nav class="d-flex gap-2 align-items-center">
    <a class="btn btn-outline-secondary @(ViewBag.Page <= 1 ? "disabled" : "")" asp-route-page="@Math.Max(1, (int)ViewBag.Page - 1)" asp-route-q="@ViewBag.Query">Anterior</a>
    <span>Página @ViewBag.Page de @ViewBag.TotalPages</span>
    <a class="btn btn-outline-secondary @(ViewBag.Page >= ViewBag.TotalPages ? "disabled" : "")" asp-route-page="@((int)ViewBag.Page + 1)" asp-route-q="@ViewBag.Query">Seguinte</a>
</nav>

@model Consultorio.Web.Models.PagamentoFormViewModel
@{ ViewData["Title"] = "Editar pagamento"; }
<h2>Editar pagamento</h2>
<p class="text-muted">Alteração de um pagamento fictício.</p>
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<form asp-action="Edit" asp-route-id="@Model.PagamentoId" method="post">
    @Html.AntiForgeryToken()
    <partial name="_Formulario" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar alterações</button>
        <a asp-action="Details" asp-route-id="@Model.PagamentoId" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
</div></div>

@model Consultorio.Web.Models.MedicoFormViewModel
@{ ViewData["Title"] = "Editar médico"; }

<h2>Editar médico</h2>
<p class="text-muted">Dados exclusivamente fictícios para demonstração.</p>
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="MedicoId" type="hidden" />
    <partial name="_Formulario" model="Model" />
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Guardar alterações</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

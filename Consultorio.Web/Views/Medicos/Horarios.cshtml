@model IEnumerable<Consultorio.Domain.Entities.HorarioMedico>

@{
    ViewData["Title"] = "Horários do médico";
    var medico = (Consultorio.Domain.Entities.Medico)ViewBag.Medico;

    string NomeDia(DayOfWeek dia) => dia switch
    {
        DayOfWeek.Monday => "Segunda-feira",
        DayOfWeek.Tuesday => "Terça-feira",
        DayOfWeek.Wednesday => "Quarta-feira",
        DayOfWeek.Thursday => "Quinta-feira",
        DayOfWeek.Friday => "Sexta-feira",
        DayOfWeek.Saturday => "Sábado",
        _ => "Domingo"
    };
}

<h2>Horários de atendimento</h2>
@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @mensagem

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Fechar">
        </button>
    </div>
}

<p>
    <strong>Médico:</strong> @medico.Nome
</p>

<div class="mb-3">
    <a asp-action="CriarHorario"
       asp-route-id="@medico.MedicoId"
       class="btn btn-primary">
        Adicionar horário
    </a>

    <a asp-action="Details"
       asp-route-id="@medico.MedicoId"
       class="btn btn-secondary">
        Voltar ao médico
    </a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Dia da semana</th>
            <th>Hora de início</th>
            <th>Hora de fim</th>
            <th>Estado</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var horario in Model)
        {
            <tr>
                <td>@NomeDia(horario.DiaSemana)</td>
                <td>@horario.HoraInicio.ToString(@"hh\:mm")</td>
                <td>@horario.HoraFim.ToString(@"hh\:mm")</td>
                <td>
                    @(horario.Ativo ? "Ativo" : "Inativo")
                </td>
                <td>
                    <form asp-action="RemoverHorario"
                          method="post"
                          onsubmit="return confirm('Remover este horário?');">
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@horario.HorarioMedicoId" />

                        <input type="hidden"
                               name="medicoId"
                               value="@medico.MedicoId" />

                        <button type="submit"
                                class="btn btn-sm btn-outline-danger">
                            Remover
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Este médico ainda não tem horários de atendimento definidos.
    </div>
}
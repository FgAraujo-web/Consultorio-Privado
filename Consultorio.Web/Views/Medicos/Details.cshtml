@model Consultorio.Domain.Entities.Medico
@{ ViewData["Title"] = "Detalhes do médico"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Detalhes do médico</h2>
        <p class="text-muted mb-0">Informação de um médico fictício do consultório.</p>
    </div>
    <div class="d-flex gap-2">

        <a asp-action="Edit"
           asp-route-id="@Model.MedicoId"
           class="btn btn-primary">
            Editar médico
        </a>

        <a asp-action="Horarios"
           asp-route-id="@Model.MedicoId"
           class="btn btn-outline-primary">
            Gerir horários
        </a>
        <a asp-action="Indisponibilidades"
           asp-route-id="@Model.MedicoId"
           class="btn btn-outline-primary">
            Gerir indisponibilidades
        </a>



        <form asp-action="AlterarEstado"
              asp-route-id="@Model.MedicoId"
              method="post"
              onsubmit="return confirm('Tem a certeza de que pretende alterar o estado deste médico?');">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn @(Model.Ativo ? "btn-outline-danger" : "btn-outline-success")">
                @(Model.Ativo ? "Desativar médico" : "Reativar médico")
            </button>
        </form>

    </div>
</div>
@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="alert alert-success" role="alert">@mensagem</div>
}
<div class="card border-0 shadow-sm"><div class="card-body p-4">
    <dl class="row mb-0">
        <dt class="col-sm-4 mb-2">Nome</dt><dd class="col-sm-8 mb-2">@Model.Nome</dd>
        <dt class="col-sm-4 mb-2">Cédula fictícia</dt><dd class="col-sm-8 mb-2">@Model.CedulaFicticia</dd>
            <dt class="col-sm-4 mb-2">Especialidade</dt>
            <dd class="col-sm-8 mb-2">@(Model.Especialidade?.Designacao ?? "—")</dd>
        <dt class="col-sm-4 mb-2">Estado</dt>
        <dd class="col-sm-8 mb-2">
            <span class="badge @(Model.Ativo ? "bg-success" : "bg-secondary")">@(Model.Ativo ? "Ativo" : "Inativo")</span>
        </dd>
    </dl>
</div></div>
<a asp-action="Index" class="btn btn-outline-secondary mt-3">Voltar à lista</a>

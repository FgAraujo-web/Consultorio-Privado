@model Consultorio.Web.Models.AtoClinicoFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input asp-for="AtoId" type="hidden" />
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="ConsultaId" class="form-label"></label>
        <select asp-for="ConsultaId" asp-items="ViewBag.Consultas" class="form-select">
            <option value="0">— Selecione uma consulta realizada —</option>
        </select>
        <span asp-validation-for="ConsultaId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="TipoAtoId" class="form-label"></label>
        <select asp-for="TipoAtoId" asp-items="ViewBag.TiposAtos" class="form-select">
            <option value="0">— Selecione o tipo de ato —</option>
        </select>
        <span asp-validation-for="TipoAtoId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DataAto" class="form-label"></label>
        <input asp-for="DataAto" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
        <span asp-validation-for="DataAto" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Valor" class="form-label"></label>
        <input asp-for="Valor" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="Valor" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Descricao" class="form-label"></label>
        <textarea asp-for="Descricao" rows="3" class="form-control"></textarea>
        <span asp-validation-for="Descricao" class="text-danger"></span>
    </div>
</div>
<div class="d-flex gap-2 mt-4">
    <button type="submit" class="btn btn-primary">Guardar ato clínico</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</div>

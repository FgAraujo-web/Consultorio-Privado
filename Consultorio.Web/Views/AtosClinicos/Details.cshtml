@model Consultorio.Domain.Entities.AtoClinico
@using System.Globalization
@{ ViewData["Title"] = "Detalhes do ato clínico"; var pt = CultureInfo.GetCultureInfo("pt-PT"); }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h2 class="mb-1">Detalhes do ato clínico</h2><p class="text-muted mb-0">Ato fictício #@Model.AtoId</p></div>
    @if (!Model.Anulado)
    {
        <a asp-action="Edit" asp-route-id="@Model.AtoId" class="btn btn-primary">Editar ato</a>
    }
</div>
@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="alert alert-success" role="alert">@mensagem</div>
}
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<dl class="row">
    <dt class="col-sm-4">Consulta</dt><dd class="col-sm-8"><a asp-controller="Consultas" asp-action="Details" asp-route-id="@Model.ConsultaId">#@Model.ConsultaId</a></dd>
    <dt class="col-sm-4">Utente</dt><dd class="col-sm-8">@(Model.Consulta?.Utente?.Nome ?? "—")</dd>
    <dt class="col-sm-4">Médico</dt><dd class="col-sm-8">@(Model.Consulta?.Medico?.Nome ?? "—")</dd>
    <dt class="col-sm-4">Tipo de ato</dt><dd class="col-sm-8">@(Model.TipoAto?.Codigo ?? "—")</dd>
    <dt class="col-sm-4">Data e hora</dt><dd class="col-sm-8">@Model.DataAto.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-4">Descrição</dt><dd class="col-sm-8">@(Model.Descricao ?? "—")</dd>
    <dt class="col-sm-4">Valor</dt><dd class="col-sm-8">@Model.Valor.ToString("C", pt)</dd>
    <dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@if(Model.Anulado){<span class="badge bg-secondary">Anulado</span>}else{<span class="badge bg-success">Válido</span>}</dd>
</dl>
@if (!Model.Anulado)
{
    <form asp-action="Anular" asp-route-id="@Model.AtoId" method="post" onsubmit="return confirm('Tem a certeza de que pretende anular este ato clínico?');">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger">Anular ato clínico</button>
    </form>
}
</div></div>
<a asp-action="Index" class="btn btn-outline-secondary mt-3">Voltar à lista</a>

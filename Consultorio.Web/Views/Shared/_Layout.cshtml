@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!doctype html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Consultório Privado</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar" aria-label="Navegação principal">
            <a class="app-brand" asp-controller="Utentes" asp-action="Index">
                <span class="brand-symbol">+</span>
                <span><strong>Consultório Privado</strong><small>Ambiente de demonstração</small></span>
            </a>
            <div class="sidebar-label">GESTÃO</div>
            <nav class="app-nav">
                <a class="@Active("Dashboard")" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a class="@Active("Utentes")" asp-controller="Utentes" asp-action="Index">Utentes</a>
                <a class="@Active("Medicos")" asp-controller="Medicos" asp-action="Index">Médicos</a>
                <a class="@Active("Especialidades")" asp-controller="Especialidades" asp-action="Index">Especialidades</a>
                <a class="@Active("Consultas")" asp-controller="Consultas" asp-action="Index">Consultas</a>
                <a class="@Active("AtosClinicos")" asp-controller="AtosClinicos" asp-action="Index">Atos clínicos</a>
                <a class="@Active("Pagamentos")" asp-controller="Pagamentos" asp-action="Index">Pagamentos</a>
                <a class="@Active("TiposAtos")" asp-controller="TiposAtos" asp-action="Index">Tipos de atos</a>
            </nav>
            <div class="sidebar-footer">Flórida Araújo | V1.0 2026</div>
        </aside>
        <div class="app-main">
            <header class="app-topbar">
                <button class="btn btn-outline-secondary d-lg-none" type="button" id="menuToggle" aria-controls="appSidebar" aria-expanded="false">☰ <span class="visually-hidden">Abrir menu</span></button>
                <div><strong>Gestão de Consultório</strong><div class="topbar-subtitle">Sistema de informação · Demonstração</div></div>
                <span class="demo-label">DEMO</span>
            </header>
            <main class="app-content">
                <div class="content-panel">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const button = document.getElementById('menuToggle');
            const sidebar = document.getElementById('appSidebar');
            button?.addEventListener('click', () => {
                const open = sidebar.classList.toggle('is-open');
                button.setAttribute('aria-expanded', String(open));
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

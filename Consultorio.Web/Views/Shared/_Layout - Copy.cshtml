<!doctype html><html lang="pt"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Consultório Demo</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/></head><body><nav class="navbar navbar-dark bg-primary"><div class="container"><a class="navbar-brand" asp-controller="Utentes" asp-action="Index">Consultório · Demonstração</a></div></nav><main class="container py-4"><div class="mb-3 d-flex flex-wrap gap-2"><a class="btn btn-outline-primary" asp-controller="Utentes">Utentes</a><a class="btn btn-outline-primary" asp-controller="Medicos">Médicos</a><a class="btn btn-outline-primary" asp-controller="Especialidades">Especialidades</a><a class="btn btn-outline-primary" asp-controller="Consultas">Consultas</a><a class="btn btn-outline-primary" asp-controller="AtosClinicos">Atos clínicos</a><a class="btn btn-outline-primary" asp-controller="Pagamentos">Pagamentos</a><a class="btn btn-outline-secondary" asp-controller="TiposAtos">Tipos de atos</a></div>@RenderBody()</main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
@using System.Globalization

@{
    ViewData["Title"] = "Dashboard";

    var pt = CultureInfo.GetCultureInfo("pt-PT");
}

<h2>Dashboard</h2>
<p class="text-muted mb-4">
    Visão geral da atividade do consultório
</p>

<div class="row g-3 mb-4">

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted">Utentes</p>
                <h2>@ViewBag.TotalUtentes</h2>
                <a asp-controller="Utentes"
                   asp-action="Index">
                    Ver utentes →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted">Médicos</p>
                <h2>@ViewBag.TotalMedicos</h2>
                <a asp-controller="Medicos"
                   asp-action="Index">
                    Ver médicos →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted">Consultas</p>
                <h2>@ViewBag.TotalConsultas</h2>
                <a asp-controller="Consultas"
                   asp-action="Index">
                    Ver consultas →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted">Pagamentos</p>
                <h2>@ViewBag.TotalPagamentos</h2>
                <a asp-controller="Pagamentos"
                   asp-action="Index">
                    Ver pagamentos →
                </a>
            </div>
        </div>
    </div>

</div>

<div class="row g-3 mb-4">

    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted">Atos clínicos</p>
                <h2>@ViewBag.TotalAtosClinicos</h2>
                <a asp-controller="AtosClinicos"
                   asp-action="Index">
                    Ver atos clínicos →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted">
                    Valor total dos pagamentos
                </p>
                <h2>
                    @(((decimal)ViewBag.ValorRecebido)
                        .ToString("C", pt))
                </h2>
            </div>
        </div>
    </div>

</div>

<div class="row g-3 mb-4">

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5>Consultas por estado</h5>

                <table class="table table-striped mt-3">
                    <thead>
                        <tr>
                            <th>Estado</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (
                            var item in ViewBag.ConsultasPorEstado)
                        {
                            <tr>
                                <td>@item.Estado</td>
                                <td class="text-end">
                                    @item.Total
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5>Próximas consultas agendadas</h5>

                <div class="table-responsive mt-3">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Data e hora</th>
                                <th>Utente</th>
                                <th>Médico</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (
                                var item in ViewBag.ProximasConsultas)
                            {
                                <tr>
                                    <td>
                                        @item.DataHora.ToString(
                                            "dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>@item.Utente</td>
                                    <td>@item.Medico</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (ViewBag.ProximasConsultas.Count == 0)
                {
                    <p class="text-muted">
                        Não existem consultas futuras
                        agendadas.
                    </p>
                }
            </div>
        </div>
    </div>

</div>

@model IEnumerable<Consultorio.Domain.Entities.TipoAto>
@using System.Globalization
@{
    ViewData["Title"] = "Tipos de atos clínicos";
    var q = ViewBag.Query as string;
    int page = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
    int total = (int)ViewBag.Total;
    var pt = CultureInfo.GetCultureInfo("pt-PT");
}
<div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
        <div><h2 class="mb-1">Tipos de atos clínicos</h2><p class="text-muted mb-0">Dados inteiramente fictícios · @total registo(s) encontrado(s) · 25 por página</p></div>
        <a asp-action="Create" class="btn btn-primary">+ Novo tipo de ato</a>
    </div>
    @if (TempData["MensagemSucesso"] is string msg) { <div class="alert alert-success">@msg</div> }
    <form method="get" asp-action="Index" class="d-flex gap-2 mb-3">
        <input name="q" value="@q" class="form-control" placeholder="Pesquisar por código ou designação" />
        <button class="btn btn-primary" type="submit">Pesquisar</button>
        @if (!string.IsNullOrWhiteSpace(q)) { <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a> }
    </form>
    <div class="table-responsive"><table class="table table-striped table-hover align-middle">
        <thead><tr><th>Código</th><th>Designação</th><th class="text-end">Preço base</th><th>Estado</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model) {
            <tr><td>@item.Codigo</td><td>@item.Designacao</td><td class="text-end">@item.PrecoBase.ToString("C", pt)</td>
                <td><span class="badge @(item.Ativo ? "bg-success" : "bg-secondary")">@(item.Ativo ? "Ativo" : "Inativo")</span></td>
                <td class="text-end"><a asp-action="Details" asp-route-id="@item.TipoAtoId">Ver</a></td></tr>
        }
        @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">Nenhum tipo de ato encontrado.</td></tr> }
        </tbody>
    </table></div>
    <nav class="d-flex align-items-center gap-2 mt-3">
        @if (page > 1) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-page="@(page - 1)" asp-route-q="@q">Anterior</a> }
        else { <button class="btn btn-outline-secondary" disabled>Anterior</button> }
            <span>Página @(page) de @(totalPages)</span>
        @if (page < totalPages) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-page="@(page + 1)" asp-route-q="@q">Seguinte</a> }
        else { <button class="btn btn-outline-secondary" disabled>Seguinte</button> }
    </nav>
</div></div>

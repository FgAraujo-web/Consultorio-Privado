@model Consultorio.Domain.Entities.TipoAto
@using System.Globalization
@{ ViewData["Title"] = "Detalhes do tipo de ato"; var pt = CultureInfo.GetCultureInfo("pt-PT"); }
<div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4">
<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div><h2 class="mb-1">Detalhes do tipo de ato</h2><p class="text-muted mb-0">Tipo de ato fictício #@Model.TipoAtoId</p></div>
    <a asp-action="Edit" asp-route-id="@Model.TipoAtoId" class="btn btn-primary">Editar tipo de ato</a>
</div>
@if (TempData["MensagemSucesso"] is string msg) { <div class="alert alert-success">@msg</div> }
<div class="border rounded-3 p-4 mb-3"><dl class="row mb-0">
<dt class="col-md-3">Código</dt><dd class="col-md-9">@Model.Codigo</dd>
<dt class="col-md-3">Designação</dt><dd class="col-md-9">@Model.Designacao</dd>
<dt class="col-md-3">Preço base</dt><dd class="col-md-9">@Model.PrecoBase.ToString("C", pt)</dd>
<dt class="col-md-3">Estado</dt><dd class="col-md-9"><span class="badge @(Model.Ativo ? "bg-success" : "bg-secondary")">@(Model.Ativo ? "Ativo" : "Inativo")</span></dd>
</dl></div>
<div class="d-flex flex-wrap gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar à lista</a>
    <form asp-action="AlternarEstado" asp-route-id="@Model.TipoAtoId" method="post" onsubmit="return confirm('Confirma a alteração do estado deste tipo de ato?');">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn @(Model.Ativo ? "btn-outline-danger" : "btn-outline-success")">@(Model.Ativo ? "Desativar tipo de ato" : "Ativar tipo de ato")</button>
    </form>
</div>
</div></div>

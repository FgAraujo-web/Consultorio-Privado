@model Consultorio.Web.Models.ConsultaFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="UtenteId" class="form-label"></label>
        <select asp-for="UtenteId" asp-items="ViewBag.Utentes" class="form-select">
            <option value="0">Selecione um utente</option>
        </select>
        <span asp-validation-for="UtenteId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MedicoId" class="form-label"></label>
        <select asp-for="MedicoId" asp-items="ViewBag.Medicos" class="form-select">
            <option value="0">Selecione um médico</option>
        </select>
        <span asp-validation-for="MedicoId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DataHora" class="form-label"></label>
        <input asp-for="DataHora" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
        <span asp-validation-for="DataHora" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DuracaoMinutos" class="form-label"></label>
        <select asp-for="DuracaoMinutos" class="form-select">
            <option value="15">15 minutos</option>
            <option value="30">30 minutos</option>
            <option value="45">45 minutos</option>
            <option value="60">60 minutos</option>
        </select>
        <span asp-validation-for="DuracaoMinutos" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Observacoes" class="form-label"></label>
        <textarea asp-for="Observacoes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Observacoes" class="text-danger"></span>
    </div>
</div>

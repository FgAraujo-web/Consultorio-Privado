@model Consultorio.Web.Models.ConsultaFormViewModel
@{ ViewData["Title"] = "Editar consulta"; }
<h2>Editar consulta</h2>
<p class="text-muted">Alteração de uma consulta agendada.</p>
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<form asp-action="Edit" asp-route-id="@Model.ConsultaId" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="ConsultaId" type="hidden" />
    <partial name="_Formulario" model="Model" />
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Guardar alterações</button>
        <a asp-action="Details" asp-route-id="@Model.ConsultaId" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

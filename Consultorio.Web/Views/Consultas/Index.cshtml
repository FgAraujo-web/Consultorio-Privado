@model IEnumerable<Consultorio.Domain.Entities.Consulta>
@{ ViewData["Title"] = "Consultas"; }
<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="mb-0">Consultas</h1>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Agenda" class="btn btn-outline-primary">Ver agenda</a>
        <a asp-action="Create" class="btn btn-primary">+ Agendar consulta</a>
    </div>
</div>
<p class="text-muted">Dados inteiramente fictícios · 25 registos por página</p>
<form method="get" class="d-flex gap-2 mb-3">
    <input name="q" value="@ViewBag.Query" class="form-control" placeholder="Pesquisar por utente, médico ou estado" />
    <button class="btn btn-primary">Pesquisar</button>
</form>
<div class="table-responsive"><table class="table table-striped table-hover">
    <thead><tr><th>Utente</th><th>Médico</th><th>Data e hora</th><th>Estado</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@(item.Utente?.Nome ?? "—")</td>
            <td>@(item.Medico?.Nome ?? "—")</td>
            <td>@item.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@item.Estado</td>
            <td><a asp-action="Details" asp-route-id="@item.ConsultaId">Ver</a></td>
        </tr>
    }
    </tbody>
</table></div>
<nav class="d-flex gap-2">
    <a class="btn btn-outline-secondary" asp-route-page="@Math.Max(1, (int)ViewBag.Page - 1)" asp-route-q="@ViewBag.Query">Anterior</a>
    <span class="align-self-center">Página @ViewBag.Page</span>
    <a class="btn btn-outline-secondary" asp-route-page="@((int)ViewBag.Page + 1)" asp-route-q="@ViewBag.Query">Seguinte</a>
</nav>
